<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/editor_bg">

    <!-- Sleek Icon Toolbar -->
    <HorizontalScrollView
        android:id="@+id/toolbarScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel_bg"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btnToggleKeyboard"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/editor_text" />

            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/editor_text" />

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_copy"
                app:tint="@color/editor_text" />

            <ImageButton
                android:id="@+id/btnPaste"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_paste"
                app:tint="@color/editor_text" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/editor_text" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="@color/editor_text" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#FF5252" />

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/accent" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Container -->
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarScroll"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.example.cppidepro.HandwritingView
            android:id="@+id/handwritingView" android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- This EditText is now synced with the main Code tab -->
        <EditText
            android:id="@+id/etHandwrittenCode"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#1E1E1E" android:fontFamily="monospace" android:gravity="top|start"
            android:padding="12dp" android:textColor="@color/editor_text" android:textSize="15sp"
            android:inputType="textMultiLine|textNoSuggestions" android:visibility="gone" />

        <!-- Floating Scroll Up/Down Buttons -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end|bottom" android:layout_margin="16dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollUp"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginBottom="8dp" android:text="▲" android:textSize="18sp"
                app:cornerRadius="24dp" app:backgroundTint="#333333" android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollDown"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="▼" android:textSize="18sp"
                app:cornerRadius="24dp" app:backgroundTint="#333333" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Recognize Button (Floating) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecognize"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="16dp"
            android:text="Recognize Pen" android:textColor="@color/black" app:backgroundTint="@color/accent"
            app:cornerRadius="24dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
