<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/editor_bg" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/editor_bg"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Dark"
        app:title="@string/app_name" app:titleTextColor="@color/white" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/editor_bg" android:orientation="horizontal"
        android:paddingStart="6dp" android:paddingTop="4dp"
        android:paddingEnd="6dp" android:paddingBottom="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabHandwriting" style="@style/Widget.CppIde.TabButton"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_margin="4dp" android:layout_weight="1" android:text="@string/tab_handwriting" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabCode" style="@style/Widget.CppIde.TabButton"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_margin="4dp" android:layout_weight="1" android:text="@string/tab_code" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabOutput" style="@style/Widget.CppIde.TabButton"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_margin="4dp" android:layout_weight="1" android:text="@string/tab_output" />
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
